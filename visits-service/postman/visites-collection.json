{
  "info": {
    "_postman_id": "visits-service-e2e-id",
    "name": "Agence Immobilière - Visits E2E",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Visit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"visitId\", jsonData.id);",
              "console.log(\"Visit ID stored: \" + jsonData.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"announcementId\": 1,\n    \"clientId\": 5,\n    \"date\": \"2026-12-01\",\n    \"heure\": \"14:30\"\n}"
        },
        "url": {
          "raw": "http://localhost:8084/api/visits",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8084",
          "path": ["api", "visits"]
        }
      }
    },
    {
      "name": "2. Get Visits By Client",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8084/api/visits/client/5",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8084",
          "path": ["api", "visits", "client", "5"]
        }
      }
    },
    {
      "name": "3. Update Visit Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Status is CONFIRMEE\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"CONFIRMEE\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "http://localhost:8084/api/visits/{{visitId}}/status?status=CONFIRMEE",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8084",
          "path": ["api", "visits", "{{visitId}}", "status"],
          "query": [
            {
              "key": "status",
              "value": "CONFIRMEE"
            }
          ]
        }
      }
    },
    {
      "name": "4. Delete Visit",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:8084/api/visits/{{visitId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8084",
          "path": ["api", "visits", "{{visitId}}"]
        }
      }
    }
  ]
}