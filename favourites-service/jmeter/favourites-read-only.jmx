            <stringProp name="ConstantTimer.delay">250</stringProp>
          </ConstantTimer>
          <hashTree />
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP 200 and JSON array">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
if (prev.getResponseCode() != '200') {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Expected HTTP 200, received ' + prev.getResponseCode())
    return
}
try {
    def payload = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    if (!(payload instanceof List)) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('Expected a JSON array')
    }
} catch (Exception ignored) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Response body is not valid JSON')
}
            </stringProp>
          </JSR223Assertion>
          <hashTree />
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Read JWT from process environment">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put('JWT_TOKEN', System.getenv('JWT_TOKEN'))</stringProp>
          </JSR223PreProcessor>
          <hashTree />
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer JWT from process environment">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${JWT_TOKEN}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree />
        </hashTree>
      </hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="Validate local target and BUYER JWT">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Validate test inputs">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">try {
    def host = props.getProperty('HOST', '127.0.0.1')
    int port = Integer.parseInt(props.getProperty('PORT', '8083'))
    def clientId = props.getProperty('CLIENT_ID', '')
    if (!(host in ['127.0.0.1', 'localhost']) || port &lt; 1 || port &gt; 65535 ||
            !(clientId ==~ /[1-9][0-9]*/) || Long.parseLong(clientId) &lt; 1) {
        throw new IllegalArgumentException()
    }
    def segments = System.getenv('JWT_TOKEN')?.split('\\.', -1)
    if (segments == null || segments.length != 3 ||
            !segments.every { it ==~ /[A-Za-z0-9_-]+/ }) {
        throw new IllegalArgumentException()
    }
    def parser = new groovy.json.JsonSlurper()
    def decoder = java.util.Base64.getUrlDecoder()
    def header = parser.parse(decoder.decode(segments[0]), 'UTF-8')
    def claims = parser.parse(decoder.decode(segments[1]), 'UTF-8')
    if (header.alg != 'HS256' || claims.role != 'BUYER' || claims.sub != clientId ||
            !(claims.exp instanceof Number) || claims.exp &lt;= java.time.Instant.now().epochSecond) {
        throw new IllegalArgumentException()
    }
    if (props.getProperty('authChecks', '0') == '1') {
        def otherId = props.getProperty('OTHER_CLIENT_ID', '')
        if (!(otherId ==~ /[1-9][0-9]*/) || Long.parseLong(otherId) &lt; 1 || otherId == clientId) {
            throw new IllegalArgumentException()
        }
    }
    SampleResult.setIgnore()
} catch (Exception ignored) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('400')
    SampleResult.setResponseMessage('Invalid loopback target, client ID or BUYER JWT')
    SampleResult.setStopTest(true)
}</stringProp>
        </JSR223Sampler>
        <hashTree />
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="JWT negative checks">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
